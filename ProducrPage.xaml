<Page x:Class="YakupovaMiracle.ProducrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YakupovaMiracle"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProducrPage" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="1" Name="ProductListView" SelectionChanged="ProductListView_SelectionChanged">
           
            <ListView.ItemTemplate>
                <DataTemplate>
                    
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="800"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Width="150" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="Logo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                /res/picture.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>


                            <TextBlock Grid.Column="1" Grid.Row="0" FontSize="20" TextWrapping="Wrap">
                             <TextBlock Text="{Binding AgentTypeTitle }"/>
                             <TextBlock Text=" | "/>
                             <TextBlock Text="{Binding Title }"/>                       
                       </TextBlock>
                            <TextBlock Text="{Binding SalesForYears, StringFormat= {}{0:0} продаж за год }" Grid.Column="1" Grid.Row="1" FontSize="15"/>
                            <TextBlock Text="{Binding Phone}" Grid.Column="1" Grid.Row="2" FontSize="15"/>
                            <TextBlock Grid.Column="1" Grid.Row="3" FontSize="15">
                            <TextBlock Text=" Приоритетность: "/>
                            <TextBlock Text="{Binding Priority}"/>
                        </TextBlock>

                            <TextBlock Text="{Binding Discount, StringFormat={}{0:0}%}" Grid.Column="2"  FontSize="40"/>

                        </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>
