<Page x:Class="Ykupova_miracle.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ykupova_miracle"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
       
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
            <TextBlock Text="Логин" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"></TextBlock>
            <TextBox Name="TBLogin" FontSize="30" Width="200" Height="35" Margin="8"></TextBox>
            <Button Name="LoginBtn"  Content="Войти" Click="LoginBtn_Click" Margin="8"></Button>
            <Button Name="GuestBtn"  Content="Войти кaк гость" Click="GuestBtn_Click" Margin="8"></Button>
            
        </StackPanel>
       
    </Grid>
</Page>
