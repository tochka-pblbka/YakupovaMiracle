<Page x:Class="Ykupova_miracle.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ykupova_miracle"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <StackPanel Orientation="Vertical">
                <TextBlock Name="FIOTB" Text="" FontSize="15"></TextBlock>
                <TextBlock Name="RoleTB" Text="" FontSize="15"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Name="TSearch" Text="Поиск" FontSize="15" HorizontalAlignment="Center"></TextBlock>
                <TextBox Name="TBSearch" Width="200" TextChanged="TBSearch_TextChanged" FontSize="14"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Name="TCateghory" Text="Категория" FontSize="15" HorizontalAlignment="Center"></TextBlock>
                <ComboBox Name="ComboCateghory" SelectionChanged="ComboCateghory_SelectionChanged" Width="175" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>Детская обувь</TextBlock>
                    <TextBlock>Женская обувь</TextBlock>
                    <TextBlock>Мужская обувь</TextBlock>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Name="TBoh" Text="Фильтровaть по" FontSize="15" HorizontalAlignment="Center"></TextBlock>
                <ComboBox Name="ComboBoh" SelectionChanged="ComboBoh_SelectionChanged" Width="175" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>по нименованию от А до я</TextBlock>
                    <TextBlock>По возрастнаию цены</TextBlock>
                    <TextBlock>По убыванию цены</TextBlock>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <ListView Grid.Row="1" Name="ProductListView" >

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="800"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Width="200"  Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>


                        <TextBlock Grid.Column="1" Grid.Row="0" FontSize="20" TextWrapping="Wrap" Margin="5">
                             <TextBlock Text="{Binding ProductName }"/>
                             <TextBlock Text=" | "/>
                             <TextBlock Text="{Binding ManufactureTitle}"/>                       
                       </TextBlock>
                        <TextBlock Text="{Binding CategoryTitle }" Grid.Column="1" Grid.Row="1" FontSize="15"/>
                        <TextBlock Text="{Binding SubCategoryTitle}" Grid.Column="1" Grid.Row="2" FontSize="15"/>
                        <StackPanel Grid.Column="2"  VerticalAlignment="Center" Grid.RowSpan="4" Orientation="Vertical"  Margin="5">
                            <TextBlock Text="Цена:"  FontSize="20"/>
                            <TextBlock Text="{Binding Price}" FontSize="20"/>
                        </StackPanel>
                        

                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Grid.Row="2"  HorizontalAlignment="Right">
       
            <TextBlock Name="TBRecordCount" Text="" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />

            <Button Name="LeftDirBtn" Content="&lt;" Click="LeftDirBtn_Click" Width="25" Height="25" Margin="10,0,0,0"></Button>
            <ListBox Name="PageListBox" FontSize="20" MouseUp="PageListBox_MouseUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Name="RightDirBtn" Content="&gt;" Click="RightDirBtn_Click" Width="25" Height="25"></Button>
        </StackPanel>

    </Grid>
</Page>