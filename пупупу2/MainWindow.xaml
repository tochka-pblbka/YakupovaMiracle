<Window x:Class="Yakupova_Miracle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Yakupova_Miracle"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontFamily="Calibri" Icon="/res/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Image Source="/res/Чудо Обувь.png" HorizontalAlignment="Left"/>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"/>
        <Button Name="BtnBack" Content="Назад" HorizontalAlignment="Right" Click="BtnBack_Click"/>
        <TextBlock Text="Чудо обувь" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
    </Grid>
</Window>
