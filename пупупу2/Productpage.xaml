<Page x:Class="Yakupova_Miracle.Productpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Yakupova_Miracle"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Productpage" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Поиск" Name="TbSearch" FontSize="15" HorizontalAlignment="Center"/>
                <TextBox Name="TbSearche" Width="200" TextChanged="TbSearche_TextChanged" FontSize = "13"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Фильтровать по" Name="TCategory" FontSize="15" HorizontalAlignment="Center"/>
                <ComboBox Name="ComboCategory" Width="200" SelectionChanged="ComboCategory_SelectionChanged" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>Детская обувь</TextBlock>
                    <TextBlock>Женская обувь</TextBlock>
                    <TextBlock>Мужская обувь</TextBlock>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Сортировать по" Name="TFiltr" FontSize="15" HorizontalAlignment="Center"/>
                <ComboBox Name="ComboFiltr" Width="200" SelectionChanged="ComboFiltr_SelectionChanged" FontSize="15">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>По увеличению цены</TextBlock>
                    <TextBlock>По уменьшению цены</TextBlock>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <ListView Name="ProductListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="800"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Grid.Column="1" Grid.Row="0" FontSize="20" TextWrapping="Wrap" Margin="5" HorizontalAlignment="Center">
                             <TextBlock Text="{Binding ProductName }"/>
                             <TextBlock Text=" | "/>
                             <TextBlock Text="{Binding ManufacturerName}"/>                       
                       </TextBlock>
                        <TextBlock Text="{Binding CategoryName }" Grid.Column="1" Grid.Row="1" FontSize="15"/>
                        <TextBlock Text="{Binding SubCategoryName}" Grid.Column="1" Grid.Row="2" FontSize="15"/>
                        <TextBlock Text="{Binding Compound}" Grid.Column="1" Grid.Row="3" FontSize="15"/>
                        <StackPanel Grid.Column="2"  VerticalAlignment="Center" Grid.RowSpan="4" Orientation="Vertical"  Margin="5">
                            <TextBlock Text="Цена:"  FontSize="20"/>
                            <TextBlock Text="{Binding Price}" FontSize="20"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Name="TBRecordCount" Text="" FontSize="14" VerticalAlignment="Center" Grid.Row="2"/>
    </Grid>
</Page>
